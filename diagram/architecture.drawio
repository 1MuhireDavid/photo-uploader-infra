        <mxCell id="n_bootstrapnote" parent="g_svc" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#5A6C7D;whiteSpace=wrap;" value="Bootstrap stack (bootstrap/00-bootstrap.yaml) creates the Templates&#xa;Bucket, the OIDC provider, both GitHub Actions roles, and the ECR&#xa;repository -- deployed ONCE, manually via the console, before Git&#xa;Sync ever runs. The ECR repo needs a real image pushed to it before&#xa;the root stack&#39;s first CREATE, since there&#39;s no NAT Gateway to fall&#xa;back on a public placeholder image." vertex="1">
          <mxGeometry height="130" width="600" x="15" y="560" as="geometry" />
        </mxCell>
